<section class="panel" id="architecture">{{template "head" index .Tabs 3}}<nav class="onpage" aria-label="On this tab">On this tab: <a href="#a-dps">Design parameters</a><a href="#a-matrices">Design matrices</a><a href="#a-decisions">Decisions</a><a href="#a-couplings">Couplings</a><a href="#expectations">Expectations</a>{{if or .Cards.States .Cards.Cells .Cards.Contexts .Cards.Workloads}}<a href="#a-conditions">State and conditions</a>{{end}}</nav></header>
<section class="block" id="a-dps" aria-labelledby="a-dps-h"><h2 id="a-dps-h">Design parameters</h2><p class="lede">A design parameter (DP) is a design choice that controls one FR. Each DP has the same number as the FR that it controls.</p>{{$caption := printf "%s, %d inactive" (plural (len .Lists.DPs) "design parameter" "design parameters") .Lists.Rejected}}{{with .Lists.DPs}}<div class="scroll" role="region" tabindex="0" aria-label="{{$caption}}"><table class="list"><caption>{{$caption}}</caption><thead><tr><th scope="col">No.</th><th scope="col">ID</th><th scope="col">Design choice</th><th scope="col">Controls</th><th scope="col">Decision</th><th scope="col">Conditions</th><th scope="col">Children</th><th scope="col">Realized by</th><th scope="col">Location</th></tr></thead><tbody>{{range .}}<tr id="{{.ID}}" class="d{{.Depth}}{{if not .Active}} rejected{{end}}"><td><span class="num">{{if .Number}}{{.Number}}{{else}}–{{end}}</span></td><td class="idc">{{ref .Ref}}</td><td class="st">{{.Statement}}</td><td>{{if .Controls}}{{refs .Controls}}{{else}}{{gap "None"}}{{end}}</td><td>{{.Decision}}{{if .Why}}<span class="why">{{.Why}}</span>{{end}}</td><td>{{if .BoundedBy}}Limited by: {{inline .BoundedBy}}<br>{{end}}{{if .HoldsIf}}Holds if: {{inline .HoldsIf}}<br>{{end}}{{if .OwnsState}}Owns: {{inline .OwnsState}}<br>{{end}}{{if .ReadsState}}Reads: {{inline .ReadsState}}{{end}}{{if not (or .BoundedBy .HoldsIf .OwnsState .ReadsState)}}{{none "None"}}{{end}}</td><td>{{if .Children}}<a class="cls {{.Children}}" href="#{{.ChildMatrix}}">{{.Children}}</a>{{else if not .Active}}{{tag (label "tool")}} Inactive{{else if .Leaf}}Leaf{{else}}{{gap "No child matrix"}}{{end}}</td><td>{{if .RealizedBy}}{{refs .RealizedBy}}{{else if .Children}}{{gap "Through child DPs"}}{{else}}{{gap "None"}}{{end}}</td><td><span class="loc">{{.Location}}</span></td></tr>{{end}}</tbody></table></div>{{else}}<p>{{gap "The model declares no design parameter."}}</p>{{end}}</section>
<section class="block" id="a-matrices" aria-labelledby="a-mx-h"><h2 id="a-mx-h">Design matrices</h2><p class="lede">Rows are FRs and columns are DPs. <b>X</b> means that the DP changes the FR. <b>0</b> means that it does not. <b>?</b> means unknown. A red X is off the diagonal: one DP also changes another FR. Hover a cell to see the reason. <a href="#g-matrix">How to read a matrix</a>.</p>{{range .Matrices}}<div class="mx" id="{{.Anchor}}"><div><h3>{{if .Master}}<code>master</code>{{else}}{{ref .ScopeRef}}{{end}} {{cls .Classification}}</h3><p class="none">{{.Label}}</p><div class="scroll" role="region" tabindex="0" aria-label="Matrix for {{.Scope}}"><table class="matrix"><thead><tr><th scope="col">FR \ DP</th>{{range .DPs}}<th scope="col"><code>{{wbr .ID}}</code>{{if .Alias}}<span class="alias">{{.Alias}}</span>{{end}}</th>{{end}}</tr></thead><tbody>{{range .Rows}}<tr><th scope="row"><code>{{wbr .FR.ID}}</code>{{if .FR.Alias}}<span class="alias">{{.FR.Alias}}</span>{{end}}</th>{{range .Cells}}<td class="{{if eq .Symbol "X"}}x{{if not .Diagonal}} off{{end}}{{else if eq .Symbol "0"}}zero{{else}}unk{{end}}" title="{{if .Explanation}}{{.Explanation}}{{else if eq .Symbol "?"}}Unknown: no declared effect{{end}}{{if .Conflict}} Conflict.{{end}}">{{.Symbol}}{{if .Conflict}} (conflict){{end}}</td>{{end}}</tr>{{end}}</tbody></table></div></div>
<div><p>{{.Meaning}}</p>{{if .Order}}<p>Design order: {{range $i, $r := .Order}}{{if $i}} then {{end}}{{ref $r}}{{end}}</p>{{end}}{{if .Unknown}}<p>{{.Unknown}} of {{.Total}} cells are unknown.</p>{{end}}{{range .Expects}}<p>Expectation {{ref .Ref}}{{if .Basis}} ({{.Basis}}){{end}}: {{tag (label "tool")}} {{.Result}}</p>{{end}}{{if .Couplings}}<p>The model records this coupling in {{inline .Couplings}}.</p>{{end}}{{if .Reasons}}<details class="group"><summary>Reasons for each cell</summary><div class="scroll" role="region" tabindex="0" aria-label="Reasons for {{.Scope}}"><table class="list"><caption>Reasons</caption><thead><tr><th scope="col">FR</th><th scope="col">DP</th><th scope="col">Effect</th><th scope="col">Reason</th><th scope="col">Basis</th><th scope="col">Location</th></tr></thead><tbody>{{range .Reasons}}<tr><td>{{ref .FR}}</td><td>{{ref .DP}}</td><td>{{.Symbol}}</td><td>{{.Text}}{{if .Locator}}<span class="why">{{.Locator}}</span>{{end}}</td><td>{{tag .Label}}</td><td><span class="loc">{{.Location}}</span></td></tr>{{end}}</tbody></table></div></details>{{end}}</div></div>{{else}}<p>{{gap "The tool assessed no matrix."}}</p>{{end}}</section>
<section class="block" id="a-decisions" aria-labelledby="a-dec-h"><h2 id="a-dec-h">Decisions and alternatives</h2><p class="lede">A decision compares candidates, each an alternative set of DPs. The Information Axiom selects the candidate with the highest probability of success, and that needs evidence.</p>{{range .Decisions}}{{$d := .}}<div id="{{.ID}}"><h3>{{ref .Ref}} {{tag .Label}}</h3><dl class="kv"><dt>Addresses</dt><dd>{{if .Addresses}}{{inline .Addresses}}{{else}}{{gap "None"}}{{end}}</dd><dt>Selected</dt><dd>{{if .Selected}}{{.Selected}}{{if .Provisional}}, provisional{{end}}{{else}}{{gap "None"}}{{end}}</dd>{{if .Why}}<dt>Why</dt><dd>{{.Why}}</dd>{{end}}{{if .Context}}<dt>Context</dt><dd>{{inline .Context}}</dd>{{end}}{{if .Workload}}<dt>Workload</dt><dd>{{inline .Workload}}</dd>{{end}}{{if .Horizon}}<dt>Horizon</dt><dd>{{.Horizon}}</dd>{{end}}<dt>Location</dt><dd><span class="loc">{{.Location}}</span></dd></dl>{{with .Candidates}}<div class="scroll" role="region" tabindex="0" aria-label="Candidates for {{$d.ID}}"><table class="list"><caption>{{plural (len .) "candidate" "candidates"}}</caption><thead><tr><th scope="col">Candidate</th><th scope="col">DPs</th><th scope="col">Information basis</th><th scope="col">Feasibility</th><th scope="col">Status</th></tr></thead><tbody>{{range .}}<tr id="{{.ID}}"><td>{{ref .Ref}}{{if .Version}}<span class="why">Version {{.Version}}</span>{{end}}</td><td>{{if .DPs}}{{refs .DPs}}{{else}}{{gap "None"}}{{end}}</td><td>{{if .Basis}}{{.Basis}} {{tag (label "source")}}{{else}}{{gap "None"}}{{end}}{{if .Evidence}}<span class="why">Evidence: {{inline .Evidence}}</span>{{end}}{{range .Estimates}}<span class="why">{{tag (label "tool")}} {{.}}</span>{{end}}</td><td>{{if .Feasibility}}{{tag (label "tool")}} {{.Feasibility}}{{else}}{{none "Not assessed"}}{{end}}</td><td>{{if .Selected}}<strong>Selected</strong>{{if $d.Provisional}}, provisional{{end}}{{else}}Not selected{{end}}</td></tr>{{end}}</tbody></table></div>{{end}}{{range .Rejected}}<p class="none">{{ref .Ref}} is {{.Decision}}{{if .Why}}: {{.Why}}{{end}}.</p>{{end}}</div>{{else}}<p>{{gap "The model records no decision."}}</p>{{end}}</section>
<section class="block" id="a-couplings" aria-labelledby="a-cp-h"><h2 id="a-cp-h">Couplings</h2><p class="lede">A coupling record explains a coupled matrix that the team keeps on purpose.</p>{{range .Couplings}}<div id="{{.ID}}"><h3>{{ref .Ref}} {{tag .Label}}</h3><dl class="kv"><dt>Scope</dt><dd>{{ref .Scope}}</dd><dt>Affects</dt><dd>{{if .Affects}}{{inline .Affects}}{{else}}{{gap "None"}}{{end}}</dd><dt>Reason</dt><dd>{{.Reason}}</dd>{{if .Condition}}<dt>Condition</dt><dd>{{.Condition}}</dd>{{end}}<dt>Decision</dt><dd>{{if .Decision}}{{.Decision}}{{else}}{{gap "None"}}{{end}}</dd>{{if .NormalPractice}}<dt>Normal practice</dt><dd>{{.NormalPractice}}</dd>{{end}}<dt>Residual risk</dt><dd>{{if .ResidualRisk}}{{.ResidualRisk}}{{else}}{{gap "None"}}{{end}}</dd><dt>Iteration bound</dt><dd>{{if .IterationBound}}{{.IterationBound}}{{else}}{{gap "None"}}{{end}}</dd><dt>Convergence</dt><dd>{{if .Convergence}}{{.Convergence}}{{else}}{{gap "None"}}{{end}}</dd><dt>Stopping rule</dt><dd>{{if .Stopping}}{{.Stopping}}{{else}}{{gap "None"}}{{end}}</dd><dt>Failure behavior</dt><dd>{{if .Failure}}{{.Failure}}{{else}}{{gap "None"}}{{end}}</dd><dt>Location</dt><dd><span class="loc">{{.Location}}</span></dd></dl></div>{{else}}<p>{{none "The model records no coupling."}}</p>{{end}}</section>
<section class="block" id="expectations" aria-labelledby="a-ex-h"><h2 id="a-ex-h">Expectations</h2><p class="lede">An expectation states the classification that a source or the team expects. The tool compares it with the assessed result.</p>{{with .Expects}}<div class="scroll" role="region" tabindex="0" aria-label="{{plural (len .) "expectation" "expectations"}}"><table class="list"><caption>{{plural (len .) "expectation" "expectations"}}</caption><thead><tr><th scope="col">ID</th><th scope="col">Scope</th><th scope="col">Expected</th><th scope="col">Assessed</th><th scope="col">Result</th></tr></thead><tbody>{{range .}}<tr id="{{.ID}}"><td>{{ref .Ref}}</td><td>{{ref .Scope}}</td><td>{{.Expected}}{{if .Order}}<span class="why">Order: {{inline .Order}}</span>{{end}}</td><td>{{if .Assessed}}{{.Assessed}} {{tag (label "tool")}}{{else}}{{gap "Not assessed"}}{{end}}</td><td>{{.Result}}</td></tr>{{end}}</tbody></table></div>{{else}}<p>{{none "The model states no expectation."}}</p>{{end}}</section>
{{if or .Cards.States .Cards.Cells .Cards.Contexts .Cards.Workloads}}<section class="block" id="a-conditions" aria-labelledby="a-cond-h"><h2 id="a-cond-h">State and conditions</h2><p class="lede">State is information that a DP owns or reads. A cells record sets the effect of the cells that no influence lists. A context or a workload names an operating condition.</p><div class="cards">{{range .Cards.States}}{{template "card" .}}{{end}}{{range .Cards.Cells}}{{template "card" .}}{{end}}{{range .Cards.Contexts}}{{template "card" .}}{{end}}{{range .Cards.Workloads}}{{template "card" .}}{{end}}</div></section>{{end}}</section>
