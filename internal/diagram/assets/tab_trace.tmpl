<section class="panel" id="trace">{{template "head" index .Tabs 5}}<nav class="onpage" aria-label="On this tab">On this tab: <a href="#t-map">Trace map</a><a href="#t-impact">Change impact</a><a href="#t-table">Trace table</a></nav></header>
<section class="block" id="t-map" aria-labelledby="t-map-h"><h2 id="t-map-h">Trace map</h2><p class="lede">Select a DP box to highlight what it affects. A dashed line is an off-diagonal or unknown effect. A ? appears on an unknown effect of the selected DP. The map shows only leaf FRs and active DPs.</p>
<div class="dark"><div class="map-scroll"><svg id="map" viewBox="0 0 {{.Map.Width}} {{.Map.Height}}" role="group" aria-label="Trace map of needs, requirements, parameters, modules and scenarios">
<text class="map-label" x="{{index .Map.Columns 0}}" y="20">NEEDS</text><text class="map-label" x="{{index .Map.Columns 1}}" y="20">REQUIREMENTS</text><text class="map-label" x="{{index .Map.Columns 2}}" y="20">PARAMETERS</text><text class="map-label" x="{{index .Map.Columns 3}}" y="20">MODULES / PVs</text><text class="map-label" x="{{index .Map.Columns 4}}" y="20">SCENARIOS</text>
{{range .Map.Rules}}<line x1="{{$.Map.RuleStart}}" x2="{{$.Map.RuleEnd}}" y1="{{.}}" y2="{{.}}" stroke="#B0AEA5" stroke-width="1"></line>{{end}}
{{range .Map.Links}}<path class="edge {{.Kind}}" data-from="{{.From}}" data-to="{{.To}}" d="{{.Path}}"></path>{{if .Label}}<text class="map-label q" data-from="{{.From}}" data-to="{{.To}}" x="{{.LabelX}}" y="{{.LabelY}}">{{.Label}}</text>{{end}}{{end}}
{{range .Map.Nodes}}<g class="node" data-id="{{.ID}}" {{if .Selectable}}role="button" tabindex="0" aria-pressed="false" aria-label="Select {{.ID}}"{{end}}><title>{{.ID}}: {{.Text}}</title><rect x="{{.X}}" y="{{.Y}}" width="{{$.Map.NodeWidth}}" height="{{$.Map.NodeHeight}}"></rect><text class="id" x="{{.X}}" y="{{.Y}}" dx="12" dy="24">{{.DisplayID}}</text><text x="{{.X}}" y="{{.Y}}" dx="12" dy="48">{{.Line1}}</text><text x="{{.X}}" y="{{.Y}}" dx="12" dy="68">{{.Line2}}</text></g>{{end}}
</svg></div><div class="detail" aria-live="polite" id="detail">Select a design parameter to see its impact.</div></div></section>
<section class="block" id="t-impact" aria-labelledby="t-imp-h"><h2 id="t-imp-h">Change impact</h2><p class="lede">This list gives the same data as the map, without JavaScript. "Possibly affected" means that the matrix cell is unknown. The tool cannot rule out an effect.</p>{{with .Lists.Impacts}}<div class="scroll" role="region" tabindex="0" aria-label="{{plural (len .) "leaf design parameter" "leaf design parameters"}}"><table class="list"><caption>{{plural (len .) "leaf design parameter" "leaf design parameters"}}</caption><thead><tr><th scope="col">If this DP changes</th><th scope="col">Affected FRs</th><th scope="col">Possibly affected (unknown cells)</th><th scope="col">Modules</th><th scope="col">PVs</th><th scope="col">Needs</th><th scope="col">Scenarios to run again</th></tr></thead><tbody>{{range .}}<tr><td>{{ref .DP}}</td><td>{{if .Affected}}{{refs .Affected}}{{else}}{{none "None"}}{{end}}</td><td>{{if .Possible}}{{refs .Possible}}{{else}}{{none "None"}}{{end}}</td><td>{{if .Modules}}{{refs .Modules}}{{else}}{{gap "None"}}{{end}}</td><td>{{if .PVs}}{{refs .PVs}}{{else}}{{gap "None"}}{{end}}</td><td>{{if .Needs}}{{refs .Needs}}{{if .NeedsDerived}}<span class="why">{{tag (label "derived")}}</span>{{end}}{{else}}{{gap "None"}}{{end}}</td><td>{{if .Scenarios}}{{refs .Scenarios}}{{else}}{{gap "None"}}{{end}}</td></tr>{{end}}</tbody></table></div>{{else}}<p>{{gap "The tool has no master matrix, so it cannot compute change impact."}}</p>{{end}}</section>
<section class="block" id="t-table" aria-labelledby="t-tr-h"><h2 id="t-tr-h">Trace table</h2><p class="lede">Each row follows one leaf requirement from the need to the module. A dashed label marks a missing link.</p>{{with .Trace}}<div class="scroll" role="region" tabindex="0" aria-label="{{plural (len .) "trace row" "trace rows"}}"><table class="list"><caption>{{plural (len .) "trace row" "trace rows"}}, one for each leaf FR</caption><thead><tr><th scope="col">Need</th><th scope="col">Capability</th><th scope="col">Leaf requirement</th><th scope="col">Criterion</th><th scope="col">Design parameter</th><th scope="col">Module and PV</th><th scope="col">Scenario</th></tr></thead><tbody>{{range .}}<tr><td>{{if .Needs}}{{refs .Needs}}{{if .NeedsDerived}}<span class="why">{{tag (label "derived")}}</span>{{end}}{{else}}{{gap "None"}}{{end}}</td><td>{{ref .Capability}}{{if .CapabilityCriteria}}<span class="why">{{refs .CapabilityCriteria}}</span>{{end}}</td><td>{{if .Path}}{{range $i, $r := .Path}}{{if $i}} › {{end}}{{ref $r}}{{end}}{{else}}{{none "Same as the capability"}}{{end}}</td><td>{{if .Criteria}}{{refs .Criteria}}{{else}}{{gap "No criterion"}}{{end}}</td><td>{{if .DPs}}{{refs .DPs}}{{else}}{{gap "No paired DP"}}{{end}}</td><td>{{if .Realized}}{{refs .Realized}}{{else}}{{gap "Missing"}}{{end}}</td><td>{{if .Scenarios}}{{refs .Scenarios}}{{else}}{{gap "Missing"}}{{end}}</td></tr>{{end}}</tbody></table></div>{{else}}<p>{{gap "The tool has no master matrix, so it has no leaf requirements to trace."}}</p>{{end}}</section></section>
