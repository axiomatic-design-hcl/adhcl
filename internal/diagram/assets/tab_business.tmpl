<section class="panel" id="business">{{template "head" index .Tabs 1}}<nav class="onpage" aria-label="On this tab">On this tab: <a href="#b-scope">Scope</a><a href="#b-stakeholders">Stakeholders</a><a href="#b-needs">Needs</a><a href="#b-constraints">Constraints</a><a href="#b-capabilities">Capabilities</a></nav></header>
<section class="block" id="b-scope" aria-labelledby="b-scope-h"><h2 id="b-scope-h">Scope</h2><dl class="kv"><dt>Boundary</dt><dd>{{.Boundary}} {{tag (label "source")}}</dd>{{if .Level}}<dt>Level</dt><dd>{{.Level}}</dd>{{end}}</dl></section>
<section class="block" id="b-stakeholders" aria-labelledby="b-st-h"><h2 id="b-st-h">Stakeholders</h2><p class="lede">A stakeholder is a person or group that the product affects.</p>{{with .Lists.Stakeholders}}<div class="scroll" role="region" tabindex="0" aria-label="{{plural (len .) "stakeholder" "stakeholders"}}"><table class="list"><caption>{{plural (len .) "stakeholder" "stakeholders"}}</caption><thead><tr><th scope="col">ID</th><th scope="col">Role</th><th scope="col">Needs</th><th scope="col">Basis</th></tr></thead><tbody>{{range .}}<tr id="{{.ID}}"><td>{{ref .Ref}}</td><td class="st">{{.Role}}</td><td>{{if .Needs}}{{refs .Needs}}{{else}}{{gap "None"}}{{end}}</td><td>{{template "basis" .}}</td></tr>{{end}}</tbody></table></div>{{else}}<p>{{gap "The model declares no stakeholder."}}</p>{{end}}</section>
<section class="block" id="b-needs" aria-labelledby="b-needs-h"><h2 id="b-needs-h">Needs</h2><p class="lede">A need is a problem of a stakeholder, in their own words. Requirements serve needs.</p>{{with .Lists.Needs}}<div class="scroll" role="region" tabindex="0" aria-label="{{plural (len .) "need" "needs"}}"><table class="list"><caption>{{plural (len .) "need" "needs"}}</caption><thead><tr><th scope="col">ID</th><th scope="col">Statement</th><th scope="col">Stakeholder</th><th scope="col">Why</th><th scope="col">Served by</th><th scope="col">Basis</th></tr></thead><tbody>{{range .}}<tr id="{{.ID}}"><td>{{ref .Ref}}</td><td class="st">{{.Statement}}</td><td>{{if .Stakeholder}}{{refs .Stakeholder}}{{else}}{{gap "None"}}{{end}}</td><td>{{if .Why}}{{.Why}}{{else}}{{gap "None"}}{{end}}</td><td>{{if .ServedBy}}{{refs .ServedBy}}{{else}}{{gap "No requirement"}}{{end}}</td><td>{{template "basis" .}}</td></tr>{{end}}</tbody></table></div>{{else}}<p>{{gap "The model declares no need."}}</p>{{end}}</section>
<section class="block" id="b-constraints" aria-labelledby="b-con-h"><h2 id="b-con-h">Constraints</h2><p class="lede">A constraint limits the acceptable solutions. It is not an outcome.</p>{{with .Lists.Constraints}}<div class="scroll" role="region" tabindex="0" aria-label="{{plural (len .) "constraint" "constraints"}}"><table class="list"><caption>{{plural (len .) "constraint" "constraints"}}</caption><thead><tr><th scope="col">ID</th><th scope="col">Kind</th><th scope="col">Statement</th><th scope="col">Limits</th><th scope="col">Basis</th></tr></thead><tbody>{{range .}}<tr id="{{.ID}}"><td>{{ref .Ref}}</td><td>{{if .Kind}}{{.Kind}}{{else}}{{gap "None"}}{{end}}</td><td class="st">{{.Statement}}</td><td>{{if .Limits}}{{refs .Limits}}{{else}}{{gap "No linked DP or FR"}}{{end}}</td><td>{{template "basis" .}}</td></tr>{{end}}</tbody></table></div>{{else}}<p>{{gap "The model declares no constraint."}}</p>{{end}}</section>
<section class="block" id="b-capabilities" aria-labelledby="b-cap-h"><h2 id="b-cap-h">Capabilities</h2><p class="lede">The top-level requirements are the capabilities of the product. The <a href="#product">product view</a> lists all requirements.</p>{{with .Lists.Capabilities}}<div class="scroll" role="region" tabindex="0" aria-label="{{plural (len .) "top-level capability" "top-level capabilities"}}"><table class="list"><caption>{{plural (len .) "top-level capability" "top-level capabilities"}}</caption><thead><tr><th scope="col">No.</th><th scope="col">Requirement</th><th scope="col">What the product must do</th><th scope="col">Need</th></tr></thead><tbody>{{range .}}<tr><td><span class="num">{{.Number}}</span></td><td>{{ref .Ref}}</td><td class="st">{{.Statement}}</td><td>{{if .Needs}}{{refs .Needs}}{{else}}{{gap "None"}}{{end}}</td></tr>{{end}}</tbody></table></div>{{else}}<p>{{gap "The model declares no requirement."}}</p>{{end}}</section></section>
