<section class="panel" id="product">{{template "head" index .Tabs 2}}<nav class="onpage" aria-label="On this tab">On this tab: <a href="#p-frs">Functional requirements</a><a href="#p-criteria">Acceptance criteria</a><a href="#p-scenarios">Scenarios</a></nav></header>
<section class="block" id="p-frs" aria-labelledby="p-frs-h"><h2 id="p-frs-h">Functional requirements</h2><p class="lede">A functional requirement (FR) is an outcome that the product must give. The number shows the place in the hierarchy. A leaf FR has no children. The alias is the ID from the source document.</p>{{$caption := printf "%s, %d of them leaves" (plural (len .Lists.FRs) "functional requirement" "functional requirements") .Lists.Leaves}}{{with .Lists.FRs}}<div class="scroll" role="region" tabindex="0" aria-label="{{$caption}}"><table class="list"><caption>{{$caption}}</caption><thead><tr><th scope="col">No.</th><th scope="col">ID</th><th scope="col">The product must…</th><th scope="col">Kind</th><th scope="col">Need</th><th scope="col">Acceptance</th><th scope="col">Controlled by</th><th scope="col">Location</th></tr></thead><tbody>{{range .}}<tr id="{{.ID}}" class="d{{.Depth}}{{if not .Active}} rejected{{end}}"><td><span class="num">{{if .Number}}{{.Number}}{{else}}–{{end}}</span></td><td class="idc">{{ref .Ref}}</td><td class="st">{{.Statement}}</td><td>{{if not .Active}}{{tag (label "tool")}} Inactive{{else if .Leaf}}Leaf{{else}}Parent{{end}}</td><td>{{if .Needs}}{{refs .Needs}}<span class="why">{{if .NeedsDerived}}{{tag (label "derived")}} inherited from {{inline .NeedFrom}}{{else}}{{tag (label "source")}}{{end}}</span>{{else}}{{gap "None"}}{{end}}</td><td>{{if .Criteria}}{{refs .Criteria}}{{else}}{{gap "No criterion"}}{{end}}{{if .NoScenario}}<br>{{gap "No scenario"}}{{end}}</td><td>{{if .ControlledBy}}{{refs .ControlledBy}}{{else}}{{gap "None"}}{{end}}{{if .BoundedBy}}<span class="why">Limited by: {{inline .BoundedBy}}</span>{{end}}</td><td><span class="loc">{{.Location}}</span></td></tr>{{end}}</tbody></table></div>{{else}}<p>{{gap "The model declares no requirement."}}</p>{{end}}</section>
<section class="block" id="p-criteria" aria-labelledby="p-cr-h"><h2 id="p-cr-h">Acceptance criteria</h2><p class="lede">An acceptance criterion is a condition that the result must meet. A measurable criterion has a metric, an operator, a value, and a unit.</p>{{$caption := printf "%s, %d measurable" (plural (len .Lists.Criteria) "acceptance criterion" "acceptance criteria") .Lists.Measurable}}{{with .Lists.Criteria}}<div class="scroll" role="region" tabindex="0" aria-label="{{$caption}}"><table class="list"><caption>{{$caption}}</caption><thead><tr><th scope="col">ID</th><th scope="col">Requirement</th><th scope="col">Condition</th><th scope="col">Measure</th><th scope="col">Scenario</th><th scope="col">Basis</th></tr></thead><tbody>{{range .}}<tr id="{{.ID}}"><td>{{ref .Ref}}</td><td>{{ref .FR}}</td><td class="st">{{if .Statement}}{{.Statement}}{{else}}{{gap "No statement"}}{{end}}</td><td>{{if .Measure}}<code>{{.Measure}}</code>{{else}}{{gap "No metric, operator, or value"}}{{end}}{{if .Under}}<span class="why">Under {{inline .Under}}</span>{{end}}{{if .AllocatedFrom}}<span class="why">Allocated from {{inline .AllocatedFrom}}</span>{{end}}</td><td>{{if .Scenarios}}{{refs .Scenarios}}{{else}}{{gap "None"}}{{end}}</td><td>{{template "basis" .}}</td></tr>{{end}}</tbody></table></div>{{else}}<p>{{gap "The model declares no acceptance criterion."}}</p>{{end}}</section>
<section class="block" id="p-scenarios" aria-labelledby="p-sc-h"><h2 id="p-sc-h">Scenarios</h2><p class="lede">A scenario describes how to test one or more criteria, with steps. A change scenario varies a DP and names the FRs that it expects to change.</p>{{with .Lists.Scenarios}}<div class="scroll" role="region" tabindex="0" aria-label="{{plural (len .) "scenario" "scenarios"}}"><table class="list"><caption>{{plural (len .) "scenario" "scenarios"}}</caption><thead><tr><th scope="col">ID</th><th scope="col">Kind</th><th scope="col">Verifies</th><th scope="col">Description and steps</th><th scope="col">Change</th><th scope="col">Result</th><th scope="col">Basis</th></tr></thead><tbody>{{range .}}<tr id="{{.ID}}"><td>{{ref .Ref}}</td><td>{{.Kind}}</td><td>{{if .Verifies}}{{refs .Verifies}}{{else}}{{gap "None"}}{{end}}</td><td class="st">{{.Description}}{{if .Steps}}<ol class="steps">{{range .Steps}}<li>{{.}}</li>{{end}}</ol>{{else}}<br>{{gap "No steps"}}{{end}}{{if .Under}}<span class="why">Under {{inline .Under}}</span>{{end}}</td><td>{{if .Vary}}Vary: {{inline .Vary}}{{if .Affected}}<br>Expect affected: {{inline .Affected}}{{end}}{{if .Unaffected}}<br>Expect unaffected: {{inline .Unaffected}}{{end}}{{else}}{{none "None"}}{{end}}</td><td>{{if .Evidence}}{{refs .Evidence}}{{else}}{{gap "No recorded result"}}{{end}}</td><td>{{template "basis" .}}</td></tr>{{end}}</tbody></table></div>{{else}}<p>{{gap "The model has no scenarios."}}</p>{{end}}{{with .Lists.LeavesWithoutScenario}}<p>{{plural (len .) "leaf requirement has" "leaf requirements have"}} no scenario: {{inline .}}.</p>{{end}}</section></section>
