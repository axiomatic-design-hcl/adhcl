<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="generator" content="adhcl {{.Version}}">
<title>{{.ID}} · Design diagram</title>
<style>{{.CSS}}</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top"><div class="wrap"><div class="row"><strong><code>{{wbr .ID}}</code></strong><div class="status" aria-label="Assessment summary"><a href="#findings">{{plural .Errors "error" "errors"}}</a><a href="#findings">{{plural .Warnings "warning" "warnings"}}</a>{{with .TopLevel}}<a href="#{{.Anchor}}">Top level: {{.Classification}}</a>{{end}}<a href="#r-evidence">{{plural .Health.Evidence "evidence record" "evidence records"}}</a></div></div>
<nav class="tabs" aria-label="Views">{{range .Tabs}}<a href="#{{.ID}}"{{if eq .ID "guide"}} class="guide"{{end}}>{{.Title}}</a>{{end}}</nav></div></header>
<main id="main"><div class="wrap">
{{template "tab_start.tmpl" .}}
{{template "tab_business.tmpl" .}}
{{template "tab_product.tmpl" .}}
{{template "tab_architecture.tmpl" .}}
{{template "tab_engineering.tmpl" .}}
{{template "tab_trace.tmpl" .}}
{{template "tab_risks.tmpl" .}}
{{template "tab_guide.tmpl" .}}
</div></main>
<footer><div class="wrap"><div class="legend"><span>Legend:</span><span>{{tag (label "source")}} stated in the model</span><span>{{tag (label "inferred")}} stated as an inference</span><span>{{tag (label "tool")}} assessed by the tool</span><span>{{tag (label "derived")}} derived from links</span><span>{{tag (label "gap")}} no record</span><span><b>X</b> effect · <b>0</b> no effect · <b>?</b> unknown</span><a href="#guide">Open the guide</a></div><p>Generated by adhcl {{.Version}} from {{plural (len .Files) "file" "files"}}. Delivery of this page does not mean that the design is valid.</p></div></footer>
<script id="impact-data" type="application/json">{"impacts":{{.Impacts}},"initial":{{.DefaultImpact}}}</script>
<script>{{.Script}}</script>
</body></html>
{{define "head"}}<header><span class="kicker">{{.Kicker}}</span><h1>{{.Heading}}</h1><p>{{.Lede}}</p>{{end}}
{{define "fact"}}<li>{{tag .Label}}<span>{{range .Parts}}{{if .Ref.ID}}{{ref .Ref}}{{else if .Cls}}{{cls .Cls}}{{else if .Href}}<a href="{{.Href}}">{{.Text}}</a>{{else}}{{.Text}}{{end}}{{end}}</span></li>{{end}}
{{define "card"}}<article class="card"{{if .Anchor}} id="{{.ID}}"{{end}}><p>{{tag .Label}} <code>{{wbr .ID}}</code></p>{{if .Text}}<p>{{.Text}}</p>{{end}}{{if .Fields}}<dl class="kv">{{range .Fields}}<dt>{{.Name}}</dt><dd>{{.Value}}</dd>{{end}}</dl>{{end}}{{if .Location}}<p class="loc">{{.Location}}</p>{{end}}</article>{{end}}
{{define "basis"}}{{tag .Label}}{{if .Location}} <span class="loc">{{.Location}}</span>{{end}}{{end}}
{{define "lines"}}{{range $i, $s := .}}{{if $i}}<br>{{end}}{{$s}}{{end}}{{end}}
