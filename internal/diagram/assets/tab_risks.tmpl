<section class="panel" id="risks">{{template "head" index .Tabs 6}}<nav class="onpage" aria-label="On this tab">On this tab: <a href="#r-open">Open items</a><a href="#r-risks">Design risks</a><a href="#r-assumptions">Assumptions</a><a href="#r-evidence">Evidence</a><a href="#findings">Findings</a></nav></header>
<section class="block" id="r-open" aria-labelledby="r-open-h"><h2 id="r-open-h">Open items</h2><p class="lede">Each row names what it counts. The counts come from the findings of the tool and from the model records.</p><div class="scroll" role="region" tabindex="0" aria-label="Open items"><table class="list"><caption>Open items</caption><thead><tr><th scope="col">Item</th><th scope="col">Count</th><th scope="col">Where</th></tr></thead><tbody>{{range .Open}}<tr><td>{{.Text}}</td><td><span class="num">{{.Count}}</span></td><td><a href="#{{.Target}}">Open</a></td></tr>{{end}}</tbody></table></div></section>
<section class="block" id="r-risks" aria-labelledby="r-risks-h"><h2 id="r-risks-h">Design risks</h2><p class="lede">A design risk is a coupling, a provisional decision, or an unknown effect that a change can expose.</p>{{if .Risks}}<ul class="facts">{{range .Risks}}{{template "fact" .}}{{end}}</ul>{{else}}<p>{{none "The model and the assessment show no design risk."}}</p>{{end}}</section>
<section class="block" id="r-assumptions" aria-labelledby="r-as-h"><h2 id="r-as-h">Assumptions</h2><p class="lede">An assumption is a premise that the design depends on. If an assumption is false, the claims that rely on it can fail.</p>{{with .Lists.Assumptions}}<div class="scroll" role="region" tabindex="0" aria-label="{{plural (len .) "assumption" "assumptions"}}"><table class="list"><caption>{{plural (len .) "assumption" "assumptions"}}</caption><thead><tr><th scope="col">ID</th><th scope="col">Statement</th><th scope="col">Status</th><th scope="col">Basis</th><th scope="col">Relied on by</th><th scope="col">Location</th></tr></thead><tbody>{{range .}}{{$row := .}}<tr id="{{.ID}}"><td>{{ref .Ref}}</td><td class="st">{{.Statement}}</td><td>{{if .Status}}{{.Status}}{{else}}{{gap "None"}}{{end}}</td><td>{{tag .Label}}</td><td>{{if or .ReliedOn .ReliedText}}{{refs .ReliedOn}}{{range $i, $t := .ReliedText}}{{if or $i $row.ReliedOn}}<br>{{end}}{{$t}}{{end}}{{else}}{{none "None"}}{{end}}</td><td><span class="loc">{{.Location}}</span></td></tr>{{end}}</tbody></table></div>{{else}}<p>{{none "The model states no assumption."}}</p>{{end}}</section>
<section class="block" id="r-evidence" aria-labelledby="r-ev-h"><h2 id="r-ev-h">Evidence</h2><p class="lede">Evidence is a recorded trial result. It shows how often a candidate meets its criteria.</p>{{with .Cards.Evidence}}<div class="cards">{{range .}}{{template "card" .}}{{end}}</div>{{else}}<p>{{gap "The model has no evidence records."}} The tool cannot estimate the probability of success for any candidate.</p>{{end}}</section>
<section class="block" id="findings" aria-labelledby="r-f-h"><h2 id="r-f-h">Findings</h2><p class="lede">{{plural .Warnings "warning" "warnings"}} and {{plural .Errors "error" "errors"}}, grouped by code. Open a group to see each finding. The <a href="#g-codes">guide</a> explains each code.</p>{{range .FindingGroups}}<details class="group"{{if eq .Severity "error"}} open{{end}}><summary><span class="count">{{.Count}}</span><code>{{wbr .Code}}</code> <span class="sev {{.Severity}}">{{.Severity}}</span><span class="mean">{{.Meaning}}</span></summary><div class="scroll" role="region" tabindex="0" aria-label="{{.Code}}"><table class="list"><caption>{{.Code}}</caption><thead><tr><th scope="col">Subject</th><th scope="col">Finding</th><th scope="col">Location</th></tr></thead><tbody>{{range .Items}}<tr><td>{{if .Subject.ID}}{{ref .Subject}}{{else}}{{none "–"}}{{end}}</td><td class="st">{{.Message}}</td><td>{{if .Location}}<span class="loc">{{.Location}}</span>{{else}}{{none "–"}}{{end}}</td></tr>{{end}}</tbody></table></div></details>{{else}}<p>{{none "The tool reported no findings."}}</p>{{end}}</section></section>
