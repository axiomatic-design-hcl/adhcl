<section class="panel" id="engineering">{{template "head" index .Tabs 4}}<nav class="onpage" aria-label="On this tab">On this tab: <a href="#e-pvs">Process variables</a><a href="#e-modules">Modules</a><a href="#e-flows">Flows</a><a href="#e-junctions">Module junctions</a>{{if .Cards.Owners}}<a href="#e-owners">Extension owners</a>{{end}}</nav></header>
<section class="block" id="e-pvs" aria-labelledby="e-pvs-h"><h2 id="e-pvs-h">Process variables</h2><p class="lede">A process variable (PV) says how the team puts a DP into practice, for example an existing subroutine.</p>{{with .Lists.PVs}}<div class="scroll" role="region" tabindex="0" aria-label="{{plural (len .) "process variable" "process variables"}}"><table class="list"><caption>{{plural (len .) "process variable" "process variables"}}</caption><thead><tr><th scope="col">ID</th><th scope="col">Kind</th><th scope="col">Realizes</th><th scope="col">Note</th><th scope="col">Basis</th></tr></thead><tbody>{{range .}}<tr id="{{.ID}}"><td>{{ref .Ref}}</td><td>{{if .Kind}}{{.Kind}}{{else}}{{gap "None"}}{{end}}</td><td>{{if .Realizes}}{{refs .Realizes}}{{else}}{{gap "None"}}{{end}}</td><td class="st">{{.Note}}{{if .Address}}<span class="why">Address: <code>{{.Address}}</code></span>{{end}}</td><td>{{template "basis" .}}</td></tr>{{end}}</tbody></table></div>{{else}}<p>{{gap "The model declares no process variable."}}</p>{{end}}</section>
<section class="block" id="e-modules" aria-labelledby="e-mod-h"><h2 id="e-mod-h">Modules</h2><p class="lede">A module is a part of the software with stated responsibilities. Its contract names its inputs, outputs, owned state, dependencies, rules, and behavior on failure. A contract without inputs, outputs, or failure behavior is incomplete.</p>{{$caption := printf "%s, %d with incomplete contracts" (plural (len .Lists.Modules) "module" "modules") .Lists.IncompleteModules}}{{with .Lists.Modules}}<div class="scroll" role="region" tabindex="0" aria-label="{{$caption}}"><table class="list"><caption>{{$caption}}</caption><thead><tr><th scope="col">ID</th><th scope="col">Realizes</th><th scope="col">Delivers</th><th scope="col">Inputs</th><th scope="col">Outputs</th><th scope="col">Owns and depends on</th><th scope="col">Rules</th><th scope="col">Failure behavior</th><th scope="col">Checks</th><th scope="col">Location</th></tr></thead><tbody>{{range .}}<tr id="{{.ID}}"><td>{{ref .Ref}}{{if .Within}}<span class="why">Within {{inline .Within}}</span>{{end}}</td><td>{{if .Realizes}}{{refs .Realizes}}{{else if .Contains}}Contains: {{refs .Contains}}{{else}}{{gap "None"}}{{end}}</td><td>{{if .Delivers}}{{refs .Delivers}}{{else}}{{none "None"}}{{end}}</td><td>{{if .Inputs}}{{template "lines" .Inputs}}{{else}}{{gap "Missing"}}{{end}}</td><td>{{if .Outputs}}{{template "lines" .Outputs}}{{else}}{{gap "Missing"}}{{end}}</td><td>{{if .Owns}}Owns: {{inline .Owns}}<br>{{end}}{{if .Depends}}Depends on: {{inline .Depends}}{{end}}{{if not (or .Owns .Depends)}}{{none "None"}}{{end}}</td><td>{{if .Invariants}}{{template "lines" .Invariants}}{{else}}{{none "None"}}{{end}}</td><td>{{if .Failure}}{{.Failure}}{{else}}{{gap "Missing"}}{{end}}</td><td>{{if .Checks}}{{refs .Checks}}{{else}}{{none "None"}}{{end}}</td><td><span class="loc">{{.Location}}</span></td></tr>{{end}}</tbody></table></div>{{else}}<p>{{gap "The model declares no module."}}</p>{{end}}</section>
<section class="block" id="e-flows" aria-labelledby="e-fl-h"><h2 id="e-fl-h">Flows</h2><p class="lede">A flow gives the order in which modules run. A box with <b>+</b> holds steps that run in any order.</p>{{range .Flows}}<div id="{{.ID}}"><h3>{{ref .Ref}} {{tag .Label}} <span class="loc">{{.Location}}</span></h3><div class="flow">{{if .Input}}<span class="io">{{.Input}}</span><span class="arrow">→</span>{{end}}{{range $i, $s := .Steps}}{{if $i}}<span class="arrow">→</span>{{end}}{{if gt (len $s) 1}}<span class="sum" title="Any order">{{range $j, $r := $s}}{{if $j}}<span class="arrow">+</span>{{end}}<span class="step">{{ref $r}}</span>{{end}}</span>{{else}}{{range $s}}<span class="step">{{ref .}}</span>{{end}}{{end}}{{end}}{{if .Output}}<span class="arrow">→</span><span class="io">{{.Output}}</span>{{end}}</div>{{if .Owner}}<p class="none">Owner: {{inline .Owner}}.</p>{{end}}{{if .After}}<p class="none">Runs after {{inline .After}}.</p>{{end}}{{range .Loops}}<p class="none">Feedback: after {{ref .After}}, return to {{ref .BackTo}} when {{.When}}. {{if .Bound}}Repeat limit: {{.Bound}}.{{else}}{{gap "No repeat limit"}}{{end}}</p>{{end}}</div>{{else}}<p>{{gap "The model declares no flow."}}</p>{{end}}</section>
<section class="block" id="e-junctions" aria-labelledby="e-jx-h"><h2 id="e-jx-h">Module junctions {{tag (label "derived")}}</h2><p class="lede">The classification of each matrix gives the junction that joins the modules under it. The page derives this table. The model does not state it.</p>{{with .Junctions}}<div class="scroll" role="region" tabindex="0" aria-label="{{plural (len .) "junction" "junctions"}}"><table class="list"><caption>{{plural (len .) "junction" "junctions"}}</caption><thead><tr><th scope="col">Scope</th><th scope="col">Classification</th><th scope="col">Junction</th><th scope="col">What it means</th></tr></thead><tbody>{{range .}}<tr><td>{{ref .Scope}}</td><td>{{cls .Classification}}</td><td>{{.Junction}}</td><td>{{.Meaning}}{{if .Order}}<span class="why">Order: {{range $i, $r := .Order}}{{if $i}} then {{end}}{{ref $r}}{{end}}</span>{{end}}{{if eq .Junction "F"}}<span class="why">{{if .Bound}}Repeat limit: {{.Bound}}.{{else}}The model gives no repeat limit.{{end}}{{if .Couplings}} See {{inline .Couplings}}.{{end}}</span>{{end}}</td></tr>{{end}}</tbody></table></div>{{else}}<p>{{none "No matrix has a classification."}}</p>{{end}}</section>
{{if .Cards.Owners}}<section class="block" id="e-owners" aria-labelledby="e-own-h"><h2 id="e-own-h">Extension owners</h2><p class="lede">An extension owner is a tool that checks one kind of extension file.</p><div class="cards">{{range .Cards.Owners}}{{template "card" .}}{{end}}</div></section>{{end}}</section>
