<rect x="480" y="200" width="70" height="30" fill="#FAF9F6" stroke="#141413"/><text x="494" y="220" font-family="ui-monospace,monospace" font-size="12">DP11</text>
<rect x="560" y="200" width="70" height="30" fill="#FAF9F6" stroke="#141413"/><text x="574" y="220" font-family="ui-monospace,monospace" font-size="12">DP12</text>
